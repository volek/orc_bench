# Optional overrides of environment.yaml. Copy to environment.local.yaml and pass
# via --env-override. These numbers match the active submit size in environment.yaml.
# layout_probe 10 x 4 x 16 GiB is not this profile.
environment:
  spark:
    deploy_mode: cluster
    executor_instances: 10
    executor_cores: 4
    executor_memory_gib: 8
    executor_memory_overhead_mib: 512
    driver_cores: 1
    driver_memory_gib: 4
